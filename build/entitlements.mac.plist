<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs these under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <!-- The panel's voice: under the hardened runtime, the microphone needs this as well as the person's yes. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Claude mode: what the person sends goes into their terminal (iTerm2, Terminal) through AppleScript. -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
