<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Update now" (update/ApkInstaller.kt): Buddy installs its own new version, once the person allows it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Voice: asked on the first press of 🎤 in the panel; the recording is written down by Buddy's server and not kept. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Filament draws the head with OpenGL ES 3.0: a phone without it is not offered Buddy. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- The chat names the app the person is in ("Done! It's in WhatsApp ✅"): Android 11 and later show Buddy the
         label of an app only when Buddy says which apps it looks for. The ones on the home screen are where people type. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name=".BuddyApp"
        android:label="Buddy"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Android's installer's answers about an update (update/ApkInstaller.kt). -->
        <receiver android:name=".update.InstallResult" android:exported="false" />
        <!-- One instance: "Open Settings" in the panel or a Fix sheet reaches the Settings already open, which scrolls to
             the part it names. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Buddy"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A long press on Buddy's icon: Claude Code. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- Claude Code on Buddy's own screen: from the panel's Claude button, and from the shortcut on Buddy's icon. Its
             own task, so that Back from it goes to where the person was, not to Settings; in Recents as "Claude Code". The
             launcher starts a shortcut as Buddy itself, so no other app needs to reach it. -->
        <activity
            android:name=".ui.claude.ClaudeActivity"
            android:exported="false"
            android:label="@string/claude_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.akshatgg.buddy.claude"
            android:theme="@style/Theme.Buddy"
            android:windowSoftInputMode="adjustResize" />
        <!-- Its own task (no affinity), kept out of Recents: the panel is a card over another app, not a screen of Buddy's. -->
        <activity
            android:name=".ui.panel.PanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Buddy.Panel"
            android:windowSoftInputMode="adjustResize" />
        <!-- "Fix with Buddy" in any app's text menu, and Buddy in the share sheet. It opens in the task of the app that
             asked, so that Replace can hand the fixed text back to it; started in a task of its own (a share sent with
             a new task), it is apart from Buddy's screens and kept out of Recents, as the panel is. A second share finds
             that task again: singleTop gives the sheet there the new text, where it would otherwise show the last one.
             singleTop still lets a result go back to the app that asked. -->
        <activity
            android:name=".ui.fix.FixActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Buddy.Panel">
            <intent-filter android:label="Fix with Buddy">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Buddy">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".bubble.BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A floating writing helper that stays on screen over other apps until the person turns it off." />
        </service>
        <!-- Buddy can type for you (and look where I type): optional, turned on by the person in Android's Accessibility
             settings. Only Android can bind it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".bubble.LookService"
            android:exported="true"
            android:label="@string/look_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/look_service" />
        </service>
        <receiver android:name=".bubble.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
